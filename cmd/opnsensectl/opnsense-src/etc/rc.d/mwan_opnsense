#!/bin/sh
# shellcheck shell=sh disable=SC2034,SC2223,SC1091
# SC2034: rcvar/cmd vars are consumed by rc.subr, not this file.
# SC2223: the `: ${var:=default}` rc.conf idiom assigns static literals.
# SC1091: /etc/rc.subr is a FreeBSD system file, not resolvable here.
# PROVIDE: mwan_opnsense
# REQUIRE: NETWORKING FILESYSTEMS
# KEYWORD: shutdown
#
# The daemon starts only from its explicit command,
#   /usr/local/sbin/mwan-opnsense daemon serve --config /usr/local/etc/opnsensectl.conf
# which this script passes to the run shim. opnsensectl install writes that
# config file. The rc.conf knobs below cover only supervision: where daemon(8)
# sends the daemon's output and how long a stop waits before it kills.
#
# Enable in /etc/rc.conf with:
#   mwan_opnsense_enable="YES"
#
# Operator knobs (defaults shown):
#   mwan_opnsense_logfile="/var/log/mwan-opnsense.log"
#   mwan_opnsense_stop_timeout="10"

. /etc/rc.subr

name="mwan_opnsense"
rcvar="${name}_enable"

load_rc_config "$name"

: ${mwan_opnsense_enable:="NO"}
: ${mwan_opnsense_logfile:="/var/log/mwan-opnsense.log"}
: ${mwan_opnsense_stop_timeout:="10"}

pidfile="/var/run/${name}.pid"
child_pidfile="/var/run/${name}.child.pid"
command="/usr/local/sbin/mwan-opnsense"
daemon_config="/usr/local/etc/opnsensectl.conf"
run_shim="/usr/local/libexec/mwan-opnsense-run"
required_files="${command} ${run_shim} ${daemon_config}"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

mwan_opnsense_status() {
	if [ -f "${pidfile}" ]; then
		pid=$(cat "${pidfile}" 2>/dev/null)
		if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
			echo "${name} is running as pid ${pid}"
			return 0
		fi
	fi
	echo "${name} is not running"
	return 1
}

mwan_opnsense_start() {
	if mwan_opnsense_status >/dev/null 2>&1; then
		echo "${name} already running"
		return 0
	fi

	rm -f "${pidfile}" "${child_pidfile}"
	# service(8) runs this script with PATH=/sbin:/bin:/usr/sbin:/usr/bin, while
	# the boot start also carries /usr/local/bin and /usr/local/sbin. Setting the
	# boot PATH here gives the daemon, and every command it runs by bare name,
	# the same environment on every start path.
	PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin:/usr/local/sbin"
	export PATH
	# daemon(8) supervises and restarts the child on an unsolicited exit
	# (-r), records the supervisor pid (-P) and the child pid (-p) so a
	# forced stop can signal the actual daemon, and redirects stdout/stderr
	# to ${mwan_opnsense_logfile}. The supervised target is the preflight
	# shim, not the daemon directly: daemon(8) re-execs the shim on every
	# (re)spawn, so the deploy preflight (revert a bad self-deploy to
	# .previous) runs before the first start and before every respawn. The
	# arguments after the shim are the daemon's full command, which the shim
	# exec's after the preflight. A SIGTERM to the supervisor (service stop)
	# forwards to the child and exits without respawning, so stop still means
	# down.
	/usr/sbin/daemon -r -P "${pidfile}" -p "${child_pidfile}" -o "${mwan_opnsense_logfile}" \
		"${run_shim}" "${command}" daemon serve --config "${daemon_config}"

	count=0
	while [ "${count}" -lt 10 ]; do
		if mwan_opnsense_status >/dev/null 2>&1; then
			mwan_opnsense_status
			return 0
		fi
		count=$((count + 1))
		sleep 1
	done

	echo "${name} failed to start" >&2
	return 1
}

mwan_opnsense_stop() {
	pid=$(cat "${pidfile}" 2>/dev/null) || {
		echo "${name} not running"
		return 0
	}

	case "${pid}" in
		*[!0-9]* | "")
			echo "${name} has invalid pidfile ${pidfile}" >&2
			return 1
			;;
	esac

	if ! kill -0 "${pid}" 2>/dev/null; then
		echo "${name} not running; removing stale pidfile"
		rm -f "${pidfile}" "${child_pidfile}"
		return 0
	fi

	# TERM the daemon(8) supervisor; it forwards SIGTERM to the child and
	# waits for the child to exit.
	kill -TERM "${pid}" 2>/dev/null || true
	count=0
	while [ "${count}" -lt "${mwan_opnsense_stop_timeout}" ]; do
		if ! kill -0 "${pid}" 2>/dev/null; then
			rm -f "${pidfile}" "${child_pidfile}"
			echo "${name} stopped"
			return 0
		fi
		count=$((count + 1))
		sleep 1
	done

	# Forced path. A child wedged in a blocking serial read does not exit
	# on SIGTERM, and a SIGKILL aimed only at the supervisor cannot be
	# forwarded, so the wedged child would orphan holding the serial
	# device. The order is load-bearing: kill the supervisor FIRST, so that
	# under daemon(8) -r (added later) it stops supervising and cannot
	# respawn the child we are about to kill. Then signal the supervisor's
	# process group: daemon(8) calls setsid, so the supervisor leads the
	# group the child shares, and the group id outlives the dead leader, so
	# a negative pid still reaches the wedged child. Finally signal the
	# tracked child directly as a fallback in case it sits in its own group.
	echo "${name} did not stop after TERM; sending KILL" >&2
	kill -KILL "${pid}" 2>/dev/null || true
	kill -KILL -- "-${pid}" 2>/dev/null || true
	child_pid=$(cat "${child_pidfile}" 2>/dev/null)
	case "${child_pid}" in
		*[!0-9]* | "") child_pid="" ;;
	esac
	if [ -n "${child_pid}" ]; then
		kill -KILL "${child_pid}" 2>/dev/null || true
	fi
	rm -f "${pidfile}" "${child_pidfile}"
}

run_rc_command "$1"
